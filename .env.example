# === PostgreSQL ===
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=blogdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bloguser:change_me_in_production@postgres:5432/blogdb

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === JWT ===
JWT_SECRET_KEY=replace-with-a-very-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_ACCESS_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true

# === MinIO (兼容 S3) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blog-uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://api.sakurakugu.top/files

# === App ===
APP_ENV=production # development or production
APP_DEBUG=false
CORS_ORIGINS=["https://www.sakurakugu.top","https://sakurakugu.top","http://localhost:5173"]
SITE_URL=https://www.sakurakugu.top

# === Android 发布签名（可选）===
ANDROID_SIGNING_STORE_FILE=
ANDROID_SIGNING_STORE_PASSWORD=
ANDROID_SIGNING_KEY_ALIAS=
ANDROID_SIGNING_KEY_PASSWORD=
ANDROID_SIGNING_STORE_TYPE=

# === Admin ===
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@sakurakugu.top
SUPER_ADMIN_PASSWORD=change_me_super_admin

DEV_ADMIN_USERNAME=dev_admin
DEV_ADMIN_EMAIL=dev_admin@sakurakugu.top
DEV_ADMIN_PASSWORD=change_me_dev_admin

DEV_USER_USERNAME=dev_user
DEV_USER_EMAIL=dev_user@sakurakugu.top
DEV_USER_PASSWORD=change_me_dev_user
