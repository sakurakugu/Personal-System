{
    email admin@sakurakugu.top
}

# 主域名统一使用 .com；裸域与 .top 全部永久跳转到 www.sakurakugu.com，避免多域名分裂。
sakurakugu.com {
    redir https://www.sakurakugu.com{uri} permanent
}

sakurakugu.top {
    redir https://www.sakurakugu.com{uri} permanent
}

www.sakurakugu.top {
    redir https://www.sakurakugu.com{uri} permanent
}

# 博客与后台前端（主入口）。
www.sakurakugu.com {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /files/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

# API 与 Twikoo 评论服务。
# .top 保留为镜像直连，兼容仍指向旧域名的客户端与历史文件地址。
api.sakurakugu.com, api.sakurakugu.top {
    encode zstd gzip
    request_body {
        max_size 12MB
    }

    handle /twikoo {
        rewrite * /
        reverse_proxy twikoo:8080
    }

    handle_path /twikoo/* {
        reverse_proxy twikoo:8080
    }

    handle /v1 {
        rewrite * /api/v1
        reverse_proxy backend:8000
    }

    handle /v1/* {
        uri replace /v1/ /api/v1/
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy backend:8000
    }
}

# Obsidian LiveSync CouchDB 端点（两个域名都直连，避免旧配置失效）
couchdb.sakurakugu.com, couchdb.sakurakugu.top {
    encode zstd gzip
    reverse_proxy couchdb:5984
}

# 青龙面板
qinglong.sakurakugu.com, qinglong.sakurakugu.top {
    encode zstd gzip
    reverse_proxy qinglong:5700
}
