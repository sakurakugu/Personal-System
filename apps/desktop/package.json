{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "electron:main": "electron ./electron/main.mjs",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:1420 && npm run electron:main\"",
    "electron:build": "npm run build && electron-builder",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/view": "^6.42.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@fancyapps/ui": "^6.1.14",
    "@iconify/vue": "^5.0.1",
    "@personal-system/api": "*",
    "@personal-system/app-core": "*",
    "@personal-system/domain": "*",
    "@personal-system/module-articles": "*",
    "@personal-system/module-auth": "*",
    "@personal-system/module-bills": "*",
    "@personal-system/module-blog": "*",
    "@personal-system/module-collections": "*",
    "@personal-system/module-files": "*",
    "@personal-system/module-moments": "*",
    "@personal-system/module-profile": "*",
    "@personal-system/module-todos": "*",
    "@personal-system/module-tools": "*",
    "@personal-system/theme": "*",
    "@personal-system/ui": "*",
    "@vscode/markdown-it-katex": "^1.1.2",
    "axios": "^1.16.0",
    "element-plus": "^2.13.7",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "md-editor-v3": "^6.5.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vue-tsc": "^3.2.8",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "top.sakurakugu.personal-system.desktop.electron",
    "productName": "Personal System",
    "electronVersion": "42.1.0",
    "directories": {
      "output": "build/release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    }
  }
}
