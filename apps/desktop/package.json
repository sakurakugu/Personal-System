{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Personal System 桌面端小工具，提供桌面常驻待办与网页后台唤起能力。",
  "author": "sakurakugu",
  "repository": {
    "type": "git",
    "url": "git@github.com:sakurakugu/Personal-System.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "electron:main": "electron ./electron/main.mjs",
    "electron:dev": "node ./scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder --config config/electron-builder.config.js",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.4",
    "@personal-system/api": "*",
    "@personal-system/app-core": "*",
    "@personal-system/domain": "*",
    "@personal-system/theme": "*",
    "@personal-system/ui": "*",
    "axios": "^1.20.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.5.1"
  }
}
