{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Personal System 桌面端应用，提供桌面壳与本地能力接入。",
  "author": "sakurakugu",
  "repository": {
    "type": "git",
    "url": "git@github.com:sakurakugu/Personal-System.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "electron:main": "electron ./electron/main.mjs",
    "electron:dev": "node ./scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder --config config/electron-builder.config.js",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/view": "^6.43.15",
    "@element-plus/icons-vue": "^2.3.2",
    "@fancyapps/ui": "^6.1.15",
    "@iconify/vue": "^5.0.4",
    "@personal-system/api": "*",
    "@personal-system/app-core": "*",
    "@personal-system/domain": "*",
    "@personal-system/module-articles": "*",
    "@personal-system/module-auth": "*",
    "@personal-system/module-bills": "*",
    "@personal-system/module-blog": "*",
    "@personal-system/module-files": "*",
    "@personal-system/module-materials": "*",
    "@personal-system/module-moments": "*",
    "@personal-system/module-profile": "*",
    "@personal-system/module-stats": "*",
    "@personal-system/module-todos": "*",
    "@personal-system/theme": "*",
    "@personal-system/ui": "*",
    "@vscode/markdown-it-katex": "^1.1.2",
    "axios": "^1.20.0",
    "element-plus": "^2.14.7",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.5.1"
  }
}
