{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@capacitor/core": ["./node_modules/@capacitor/core"],
      "@codemirror/commands": ["./node_modules/@codemirror/commands"],
      "@codemirror/view": ["./node_modules/@codemirror/view"],
      "@element-plus/icons-vue": ["./node_modules/@element-plus/icons-vue"],
      "@fancyapps/ui": ["./node_modules/@fancyapps/ui"],
      "@fancyapps/ui/*": ["./node_modules/@fancyapps/ui/*"],
      "@iconify/vue": ["./node_modules/@iconify/vue"],
      "@personal-system/app-core": ["../../packages/app-core/src/index.ts"],
      "@personal-system/api": ["../../packages/api/src/index.ts"],
      "@personal-system/domain/auth": ["../../packages/domain/src/auth/index.ts"],
      "@personal-system/domain/system": ["../../packages/domain/src/system/index.ts"],
      "@personal-system/domain/todos": ["../../packages/domain/src/todos/index.ts"],
      "@personal-system/modules/articles": ["../../packages/modules/articles/src/index.ts"],
      "@personal-system/modules/auth": ["../../packages/modules/auth/src/index.ts"],
      "@personal-system/modules/bills": ["../../packages/modules/bills/src/index.ts"],
      "@personal-system/modules/collections": ["../../packages/modules/collections/src/index.ts"],
      "@personal-system/modules/moments": ["../../packages/modules/moments/src/index.ts"],
      "@personal-system/modules/profile": ["../../packages/modules/profile/src/index.ts"],
      "@personal-system/modules/tools": ["../../packages/modules/tools/src/index.ts"],
      "@personal-system/modules/todos": ["../../packages/modules/todos/src/index.ts"],
      "@personal-system/theme": ["../../packages/theme/src/index.ts"],
      "@personal-system/theme/*": ["../../packages/theme/src/*"],
      "@personal-system/ui": ["../../packages/ui/src/index.ts"],
      "@personal-system/ui/*": ["../../packages/ui/src/*"],
      "@vscode/markdown-it-katex": ["./node_modules/@vscode/markdown-it-katex"],
      "axios": ["./node_modules/axios"],
      "element-plus": ["./node_modules/element-plus"],
      "highlight.js": ["./node_modules/highlight.js"],
      "highlight.js/*": ["./node_modules/highlight.js/*"],
      "katex": ["./node_modules/katex"],
      "katex/*": ["./node_modules/katex/*"],
      "markdown-it": ["./node_modules/@types/markdown-it"],
      "markdown-it-abbr": ["./node_modules/markdown-it-abbr"],
      "markdown-it-emoji": ["./node_modules/markdown-it-emoji"],
      "markdown-it-footnote": ["./node_modules/markdown-it-footnote"],
      "markdown-it-mark": ["./node_modules/markdown-it-mark"],
      "markdown-it-task-lists": ["./node_modules/markdown-it-task-lists"],
      "markmap-lib": ["./node_modules/markmap-lib"],
      "markmap-view": ["./node_modules/markmap-view"],
      "md-editor-v3": ["./node_modules/md-editor-v3"],
      "md-editor-v3/*": ["./node_modules/md-editor-v3/*"],
      "pinia": ["./node_modules/pinia"],
      "vue": ["./node_modules/vue"],
      "vue-router": ["./node_modules/vue-router"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../../packages/**/*.ts",
    "../../packages/**/*.d.ts",
    "../../packages/**/*.vue"
  ]
}
