{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:mobile-local": "vue-tsc -b && vite build --mode mobile-local",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "cap:copy": "npm run build && npx cap copy",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:local": "npm run build:mobile-local && npx cap sync android",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:android:local": "npm run cap:sync:local && npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/status-bar": "^8.0.2",
    "@element-plus/icons-vue": "^2.3.2",
    "@fancyapps/ui": "^6.1.13",
    "@iconify-json/codicon": "^1.2.51",
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "culori": "^4.0.2",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "md-editor-v3": "^6.4.1",
    "mouse-firework": "^0.3.0-beta.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "simple-icons": "^16.13.0",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "postcss-custom-media": "^12.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vue-tsc": "^3.2.6"
  }
}
